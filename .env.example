# ============================================================
# Verse Dedication — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local (it is git-ignored).
# ============================================================

# ---- Supabase (Project Settings → API) ----
# Safe to expose to the browser (RLS protects the data):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY — never expose. Bypasses RLS. Used by the Stripe webhook.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe (Dashboard → Developers → API keys) ----
# SERVER ONLY:
STRIPE_SECRET_KEY=sk_test_xxx

# The signing secret for the webhook endpoint you create in Stripe
# (Developers → Webhooks → Add endpoint → https://your-domain/api/stripe-webhook)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: use pre-created Stripe Prices instead of inline pricing.
# If set, these take priority over the amounts in src/lib/pricing.js.
# STRIPE_PRICE_DIGITAL=price_xxx
# STRIPE_PRICE_HEIRLOOM=price_xxx

# ---- Site ----
# Public base URL, no trailing slash. Used for Stripe success/cancel URLs + cert links.
NEXT_PUBLIC_SITE_URL=https://versededication.com

# ---- Email (Resend) ----
# SERVER ONLY. If unset, the webhook still records the order but skips the email.
RESEND_API_KEY=re_xxx
EMAIL_FROM="Verse Dedication <certificates@versededication.com>"

# ---- Supabase Storage ----
# Bucket where generated certificate PDFs are stored. Create it in Supabase → Storage.
# Make it PUBLIC (so the emailed link works) or keep private + swap to signed URLs.
CERTIFICATE_BUCKET=certificates

# ---- Admin (order fulfilment at /admin) ----
# SERVER ONLY. A single shared password guarding /admin and /api/admin/orders.
# Use a long random string. If unset, the admin area is disabled (returns 503).
ADMIN_SECRET=change-me-to-a-long-random-string
